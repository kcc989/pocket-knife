{
	"name": "@switch-examples/doc-extract",
	"version": "0.1.0",
	"private": true,
	"description": "An example harness on switch: a decision model picks which part of a document to read, and an extractor reads the values from it.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --check .",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"dry": "slophammer-ts dry .",
		"check": "pnpm format && pnpm lint && pnpm typecheck && pnpm coverage && pnpm dry",
		"eval": "node --conditions=switch-source eval/live.ts"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "1.4.0",
		"@osolmaz/switch": "workspace:*",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "22.19.1",
		"@vitest/coverage-v8": "5.0.5",
		"eslint": "10.13.0",
		"prettier": "3.9.10",
		"slophammer-ts": "0.5.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vitest": "5.0.5"
	}
}
